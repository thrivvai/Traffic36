# Copy to .env for local development. Never commit real values.
# In Netlify these live under Project configuration > Environment variables.

# Clerk (sign-in). The publishable key is public; the secret key is not.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk's PEM public key, for networkless token checks.
CLERK_JWT_KEY=

# Who checks driver's licenses: leave unset for the host to review photos by hand, or set to
# "stripe" to use Stripe Identity instead (then the two Stripe settings below are required).
ID_CHECK=

# Stripe Identity (only when ID_CHECK=stripe). A restricted key: Identity verification sessions
# Write, Identity Verification Results Read, Recent Detailed Verification Results Read.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Where renters send money. Leave one blank to turn that method off.
CASHAPP_CASHTAG=
CHIME_PHONE=

# Comma-separated emails that get the host console.
HOST_EMAILS=

# Local QA only: signs in a pretend user so screens can be checked without Clerk.
# Has no effect in production builds.
# VITE_FAKE_SESSION=1
